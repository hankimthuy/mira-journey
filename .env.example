# Production URL for SEO metadata (canonical, sitemap, robots)
# Set this in Vercel Environment Variables for Production:
#   NEXT_PUBLIC_SITE_URL=https://journey.hankimthuy.com
NEXT_PUBLIC_SITE_URL=https://journey.hankimthuy.com

# --- Supabase (required) ----------------------------------------------------
# Posts are read from Supabase, not from content/posts/*.md. Without these the
# build fails at startup with an explicit message. Project Settings -> API in
# the Supabase dashboard. The anon key only ever sees published, public posts —
# row level security enforces that.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Umami analytics --------------------------------------------------------
# Tracking only renders when BOTH are set, so local dev and preview deploys
# never pollute production stats. Website ID comes from the Umami dashboard.
NEXT_PUBLIC_UMAMI_SRC=https://cloud.umami.is/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=your-website-id

# --- Local only: one-off content migration ----------------------------------
# Used by: node --env-file=.env.local scripts/migrate-to-supabase.mjs
# The service-role key bypasses row level security — keep it out of git and
# out of Vercel. Add --dry-run first to preview without writing.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
