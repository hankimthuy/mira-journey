# Production URL for SEO metadata (canonical, sitemap, robots)
# Set this in Vercel Environment Variables for Production:
#   NEXT_PUBLIC_SITE_URL=https://journey.hankimthuy.com
NEXT_PUBLIC_SITE_URL=https://journey.hankimthuy.com

# --- Supabase (required) ----------------------------------------------------
# Posts are read from Supabase, not from content/posts/*.md. Without these the
# build fails at startup with an explicit message. Project Settings -> API in
# the Supabase dashboard. The anon key only ever sees published, public posts —
# row level security enforces that.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Analytics ---------------------------------------------------------------
# Endpoint of the admin app's collector. Tracking only renders when this is set,
# so local dev and preview deploys never pollute production stats — leave it
# unset locally and define it on Vercel Production only.
NEXT_PUBLIC_ANALYTICS_URL=https://admin.hankimthuy.com/api/collect

# --- Service-role key (required) ---------------------------------------------
# Used by: scripts/migrate-to-supabase.mjs (local one-off import), AND now
# lib/supabase-admin.ts at runtime for the like/comment write paths (bypasses
# RLS so the app can insert after its own rate-limit/spam checks) — this is
# no longer local-only, it must also be set in Vercel Environment Variables.
# Never expose to the client, never commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Likes & comments: anti-spam ---------------------------------------------
# openssl rand -hex 32 — salts hashed visitor IPs so raw IPs are never stored.
IP_HASH_SALT=

# --- Comment email notification (optional) -----------------------------------
# No-op until both are set — safe to leave unset. Once the CMS side exposes a
# real endpoint, set these two and email notifications start working with no
# code change. Contract: POST {url} with Authorization: Bearer {token} (if
# set) and JSON body {postSlug, postTitle, authorName, content, commentUrl}.
# COMMENT_NOTIFY_WEBHOOK_URL=
# COMMENT_NOTIFY_WEBHOOK_TOKEN=
